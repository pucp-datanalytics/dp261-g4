    "probability_revenue",
    "prediction",
    "threshold",
    "model_name",
    "policy"
  ],
  "properties": {
    "probability_revenue": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "prediction": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "model_name": {
      "type": "string"
    },
    "policy": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    }
  }
}